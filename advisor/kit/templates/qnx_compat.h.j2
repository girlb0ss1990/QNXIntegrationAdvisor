#ifndef QNX_COMPAT_H
#define QNX_COMPAT_H

#include <errno.h>
#include <stdint.h>
#include <time.h>
#include <unistd.h>

#ifdef __QNX__
#include <sys/neutrino.h>
#include <sys/siginfo.h>

#ifdef _NTO_CHF_PRIVATE
#define QNX_COMPAT_CHF _NTO_CHF_PRIVATE
#else
#define QNX_COMPAT_CHF 0
#endif

#define QNX_COMPAT_PULSE_TIMER   (_PULSE_CODE_MINAVAIL + 0)
#endif /* __QNX__ */
{%- if need_timer %}

/* ------------------------------------------------------------------ periodic timer */
typedef struct {
#ifdef __QNX__
    int     chid;
    int     coid;
    timer_t timer;
#else
    int     fd;
#endif
} qnx_periodic_timer_t;

#ifdef __QNX__
static inline int qnx_periodic_timer_create(qnx_periodic_timer_t *t, uint64_t period_ns, int pulse_prio)
{
    struct sigevent   ev;
    struct itimerspec its;

    t->chid = ChannelCreate(QNX_COMPAT_CHF);
    if (t->chid == -1)
        return -1;
    t->coid = ConnectAttach(0, 0, t->chid, _NTO_SIDE_CHANNEL, 0);
    if (t->coid == -1) {
        ChannelDestroy(t->chid);
        return -1;
    }
    SIGEV_PULSE_INIT(&ev, t->coid, pulse_prio, QNX_COMPAT_PULSE_TIMER, 0);
    if (timer_create(CLOCK_MONOTONIC, &ev, &t->timer) == -1) {
        ConnectDetach(t->coid);
        ChannelDestroy(t->chid);
        return -1;
    }
    its.it_value.tv_sec  = (time_t)(period_ns / 1000000000ULL);
    its.it_value.tv_nsec = (long)(period_ns % 1000000000ULL);
    its.it_interval      = its.it_value;
    if (timer_settime(t->timer, 0, &its, NULL) == -1) {
        timer_delete(t->timer);
        ConnectDetach(t->coid);
        ChannelDestroy(t->chid);
        return -1;
    }
    return 0;
}

/* Blocks until the next period. Other pulses on this private channel are ignored. */
static inline int qnx_periodic_timer_wait(qnx_periodic_timer_t *t)
{
    struct _pulse p;
    for (;;) {
        if (MsgReceivePulse(t->chid, &p, sizeof p, NULL) == -1)
            return -1;
        if (p.code == QNX_COMPAT_PULSE_TIMER)
            return 0;
    }
}

static inline void qnx_periodic_timer_destroy(qnx_periodic_timer_t *t)
{
    timer_delete(t->timer);
    ConnectDetach(t->coid);
    ChannelDestroy(t->chid);
}
#else  /* Linux and other POSIX hosts keep the original timerfd behaviour */
#include <sys/timerfd.h>
static inline int qnx_periodic_timer_create(qnx_periodic_timer_t *t, uint64_t period_ns, int pulse_prio)
{
    struct itimerspec its;
    (void)pulse_prio;
    t->fd = timerfd_create(CLOCK_MONOTONIC, 0);
    if (t->fd == -1)
        return -1;
    its.it_value.tv_sec  = (time_t)(period_ns / 1000000000ULL);
    its.it_value.tv_nsec = (long)(period_ns % 1000000000ULL);
    its.it_interval      = its.it_value;
    return timerfd_settime(t->fd, 0, &its, NULL);
}

static inline int qnx_periodic_timer_wait(qnx_periodic_timer_t *t)
{
    uint64_t exp;
    return read(t->fd, &exp, sizeof exp) == (ssize_t)sizeof exp ? 0 : -1;
}

static inline void qnx_periodic_timer_destroy(qnx_periodic_timer_t *t)
{
    close(t->fd);
}
#endif
{%- endif %}
{%- if need_notifier %}

/* ------------------------------------------------------------------ notifier */
typedef struct {
#ifdef __QNX__
    int coid;
    int code;
#else
    int fds[2];
#endif
} qnx_notifier_t;

#ifdef __QNX__
/* chid: the receiving loop's channel. code: a pulse code >= _PULSE_CODE_MINAVAIL. */
static inline int qnx_notifier_init(qnx_notifier_t *n, int chid, int code)
{
    n->code = code;
    n->coid = ConnectAttach(0, 0, chid, _NTO_SIDE_CHANNEL, 0);
    return n->coid == -1 ? -1 : 0;
}

static inline int qnx_notifier_signal(qnx_notifier_t *n, int value)
{
    return MsgSendPulse(n->coid, -1, n->code, value);   /* -1: sender's priority */
}

static inline void qnx_notifier_destroy(qnx_notifier_t *n)
{
    ConnectDetach(n->coid);
}
#else
#include <fcntl.h>
static inline int qnx_notifier_init(qnx_notifier_t *n, int chid, int code)
{
    (void)chid; (void)code;
    if (pipe(n->fds) == -1)
        return -1;
    return fcntl(n->fds[1], F_SETFL, O_NONBLOCK);
}

static inline int qnx_notifier_signal(qnx_notifier_t *n, int value)
{
    unsigned char b = (unsigned char)value;
    return write(n->fds[1], &b, 1) == 1 ? 0 : -1;
}

static inline void qnx_notifier_destroy(qnx_notifier_t *n)
{
    close(n->fds[0]);
    close(n->fds[1]);
}
#endif
{%- endif %}

#endif /* QNX_COMPAT_H */
