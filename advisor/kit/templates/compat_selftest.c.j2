/*
 * compat_selftest.c - exercises qnx_compat.h so the shims are compiled and run on the target.
 * Generated by QNX Integration Advisor for {{ repo_name }}. Apache-2.0.
 * Exit status 0 means every shim worked.
 */
#include <stdio.h>
#include <stdlib.h>

#include "qnx_compat.h"

int main(void)
{
    int failures = 0;
{%- if need_timer %}
    qnx_periodic_timer_t t;
    if (qnx_periodic_timer_create(&t, 1000000ULL, 10) != 0) {
        perror("qnx_periodic_timer_create");
        failures++;
    } else {
        for (int i = 0; i < 100; i++) {
            if (qnx_periodic_timer_wait(&t) != 0) {
                perror("qnx_periodic_timer_wait");
                failures++;
                break;
            }
        }
        qnx_periodic_timer_destroy(&t);
        printf("periodic timer: 100 periods ok\n");
    }
{%- endif %}
{%- if need_notifier %}
#ifdef __QNX__
    int chid = ChannelCreate(QNX_COMPAT_CHF);
    qnx_notifier_t n;
    if (chid == -1 || qnx_notifier_init(&n, chid, _PULSE_CODE_MINAVAIL + 5) != 0) {
        perror("qnx_notifier_init");
        failures++;
    } else {
        struct _pulse p;
        if (qnx_notifier_signal(&n, 42) == -1 || MsgReceivePulse(chid, &p, sizeof p, NULL) == -1
            || p.code != _PULSE_CODE_MINAVAIL + 5 || p.value.sival_int != 42) {
            fprintf(stderr, "notifier pulse mismatch\n");
            failures++;
        } else {
            printf("notifier: pulse ok\n");
        }
        qnx_notifier_destroy(&n);
        ChannelDestroy(chid);
    }
#endif
{%- endif %}
    return failures == 0 ? EXIT_SUCCESS : EXIT_FAILURE;
}
