/*
 * qnx_{{ svc }}_resmgr.c - single-threaded QNX 8.0 resource manager skeleton at /dev/{{ svc }}.
 * Generated by QNX Integration Advisor for {{ repo_name }}. Apache-2.0.
 *
 *   read()   -> text status line
 *   write()  -> sets an integer value (e.g. a setpoint)
 *   devctl() -> DCMD_{{ SVC }}_GET_STATUS / DCMD_{{ SVC }}_SET_VALUE ({{ svc }}_dcmd.h)
 *   periodic timer pulse (pulse_attach) -> tick_handler(), where the repo's loop body goes
 *
 * Build:  qcc -Vgcc_ntox86_64 -Wall -Wextra -Werror -Iinclude -Isrc -o {{ svc }}_resmgr src/qnx_{{ svc }}_resmgr.c
 * Run:    {{ svc }}_resmgr -p {{ period_ms }} -u 1000 &      (starts as root, drops to uid 1000)
 */
#include <errno.h>
#include <fcntl.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>
#include <unistd.h>

#include <devctl.h>
#include <sys/dispatch.h>
#include <sys/iofunc.h>
#include <sys/neutrino.h>
#include <sys/procmgr.h>
#include <sys/stat.h>

#include "{{ svc }}_dcmd.h"

typedef struct {
{%- if main_struct %}
    /* TODO: embed the repository's main state ({{ main_struct[0] }} from {{ main_struct[1] }}) here. */
{%- endif %}
    {{ svc }}_status_t status;
} service_state_t;

static service_state_t        state;
static resmgr_connect_funcs_t connect_funcs;
static resmgr_io_funcs_t      io_funcs;
static iofunc_attr_t          dev_attr;
static char                   read_buf[128];

/* ------------------------------------------------------------------ read() */
static int io_read(resmgr_context_t *ctp, io_read_t *msg, RESMGR_OCB_T *ocb)
{
    int status = iofunc_read_verify(ctp, msg, ocb, NULL);
    if (status != EOK)
        return status;
    if ((msg->i.xtype & _IO_XTYPE_MASK) != _IO_XTYPE_NONE)
        return ENOSYS;

    if (ocb->offset == 0) {
        int n = snprintf(read_buf, sizeof read_buf, "value=%d ticks=%llu\n",
                         (int)state.status.value, (unsigned long long)state.status.ticks);
        if (n < 0)
            return EIO;
    }
    size_t len = strlen(read_buf);
    size_t nbytes = 0;
    if (ocb->offset >= 0 && (size_t)ocb->offset < len) {
        nbytes = len - (size_t)ocb->offset;
        if (nbytes > (size_t)_IO_READ_GET_NBYTES(msg))
            nbytes = (size_t)_IO_READ_GET_NBYTES(msg);
    }
    _IO_SET_READ_NBYTES(ctp, nbytes);
    if (nbytes == 0)
        return _RESMGR_NPARTS(0);
    SETIOV(ctp->iov, read_buf + ocb->offset, nbytes);
    ocb->offset += (off_t)nbytes;
    ocb->attr->flags |= IOFUNC_ATTR_ATIME;
    return _RESMGR_NPARTS(1);
}

/* ------------------------------------------------------------------ write() */
static int io_write(resmgr_context_t *ctp, io_write_t *msg, RESMGR_OCB_T *ocb)
{
    int status = iofunc_write_verify(ctp, msg, ocb, NULL);
    if (status != EOK)
        return status;
    if ((msg->i.xtype & _IO_XTYPE_MASK) != _IO_XTYPE_NONE)
        return ENOSYS;

    size_t nbytes = (size_t)_IO_WRITE_GET_NBYTES(msg);
    char   buf[32];
    size_t want = nbytes < sizeof buf - 1 ? nbytes : sizeof buf - 1;
    ssize_t got = resmgr_msgread(ctp, buf, want, sizeof msg->i);
    if (got == -1)
        return errno;
    buf[got] = '\0';
    state.status.value = (int32_t)strtol(buf, NULL, 10);   /* TODO: parse the repo's command format */

    _IO_SET_WRITE_NBYTES(ctp, nbytes);
    if (nbytes > 0)
        ocb->attr->flags |= IOFUNC_ATTR_MTIME | IOFUNC_ATTR_CTIME;
    return EOK;
}

/* ------------------------------------------------------------------ devctl() */
static int io_devctl(resmgr_context_t *ctp, io_devctl_t *msg, RESMGR_OCB_T *ocb)
{
    int status = iofunc_devctl_default(ctp, msg, ocb);
    if (status != _RESMGR_DEFAULT)
        return status;

    void  *data = _DEVCTL_DATA(msg->i);
    size_t nbytes = 0;

    switch (msg->i.dcmd) {
    case DCMD_{{ SVC }}_GET_STATUS:
        if (msg->i.nbytes < sizeof(state.status))
            return EINVAL;
        memcpy(data, &state.status, sizeof(state.status));
        nbytes = sizeof(state.status);
        break;
    case DCMD_{{ SVC }}_SET_VALUE: {
        int32_t v;
        if (msg->i.nbytes < sizeof v)
            return EINVAL;
        if (resmgr_msgread(ctp, &v, sizeof v, sizeof msg->i) != (ssize_t)sizeof v)
            return EFAULT;
        state.status.value = v;
        break;
    }
    default:
        return ENOSYS;
    }

    memset(&msg->o, 0, sizeof msg->o);
    msg->o.ret_val = EOK;
    msg->o.nbytes = (uint32_t)nbytes;
    return _RESMGR_PTR(ctp, &msg->o, sizeof msg->o + nbytes);
}

/* ------------------------------------------------------------------ timer pulse */
static int tick_handler(message_context_t *ctp, int code, unsigned flags, void *handle)
{
    (void)ctp; (void)code; (void)flags; (void)handle;
    state.status.ticks++;
    /* TODO: move the body of {{ repo_name }}'s periodic loop here
       (read inputs, compute, write outputs). It runs in the resmgr's single thread,
       so it is serialized with client requests and needs no extra locking. */
    return 0;
}

static int drop_privileges(uid_t uid)
{
    /* Path registration is done. Deny and lock every ability for the non-root domain,
       then become that user. */
    int rc = procmgr_ability(0, PROCMGR_ADN_NONROOT | PROCMGR_AOP_DENY | PROCMGR_AOP_LOCK | PROCMGR_AID_EOL);
    if (rc != EOK) {
        fprintf(stderr, "procmgr_ability: %s\n", strerror(rc));
        return -1;
    }
    if (setgid((gid_t)uid) == -1 || setuid(uid) == -1) {
        perror("setuid");
        return -1;
    }
    return 0;
}

int main(int argc, char **argv)
{
    long period_ms = {{ period_ms }};
    long run_uid = -1;
    int  opt;
    while ((opt = getopt(argc, argv, "p:u:")) != -1) {
        switch (opt) {
        case 'p': period_ms = strtol(optarg, NULL, 10); break;
        case 'u': run_uid = strtol(optarg, NULL, 10); break;
        default:
            fprintf(stderr, "usage: %s [-p period_ms] [-u uid]\n", argv[0]);
            return EXIT_FAILURE;
        }
    }
    if (period_ms <= 0)
        period_ms = {{ period_ms }};

    dispatch_t *dpp = dispatch_create();
    if (dpp == NULL) {
        perror("dispatch_create");
        return EXIT_FAILURE;
    }

    resmgr_attr_t rattr;
    memset(&rattr, 0, sizeof rattr);
    rattr.nparts_max = 1;
    rattr.msg_max_size = 2048;

    iofunc_func_init(_RESMGR_CONNECT_NFUNCS, &connect_funcs, _RESMGR_IO_NFUNCS, &io_funcs);
    io_funcs.read = io_read;
    io_funcs.write = io_write;
    io_funcs.devctl = io_devctl;
    iofunc_attr_init(&dev_attr, S_IFCHR | 0666, NULL, NULL);

    if (resmgr_attach(dpp, &rattr, "/dev/{{ svc }}", _FTYPE_ANY, 0, &connect_funcs, &io_funcs, &dev_attr) == -1) {
        perror("resmgr_attach /dev/{{ svc }}");
        return EXIT_FAILURE;
    }

    int code = pulse_attach(dpp, MSG_FLAG_ALLOC_PULSE, 0, tick_handler, NULL);
    if (code == -1) {
        perror("pulse_attach");
        return EXIT_FAILURE;
    }
    int coid = message_connect(dpp, MSG_FLAG_SIDE_CHANNEL);
    if (coid == -1) {
        perror("message_connect");
        return EXIT_FAILURE;
    }
    struct sigevent ev;
    SIGEV_PULSE_INIT(&ev, coid, {{ pulse_prio }}, code, 0);
    timer_t timer;
    if (timer_create(CLOCK_MONOTONIC, &ev, &timer) == -1) {
        perror("timer_create");
        return EXIT_FAILURE;
    }
    struct itimerspec its;
    its.it_value.tv_sec = period_ms / 1000;
    its.it_value.tv_nsec = (period_ms % 1000) * 1000000L;
    its.it_interval = its.it_value;
    if (timer_settime(timer, 0, &its, NULL) == -1) {
        perror("timer_settime");
        return EXIT_FAILURE;
    }

    if (run_uid >= 0 && drop_privileges((uid_t)run_uid) != 0)
        return EXIT_FAILURE;

    dispatch_context_t *ctp = dispatch_context_alloc(dpp);
    if (ctp == NULL) {
        perror("dispatch_context_alloc");
        return EXIT_FAILURE;
    }
    for (;;) {
        dispatch_context_t *next = dispatch_block(ctp);
        if (next == NULL) {
            if (errno == EINTR)
                continue;
            perror("dispatch_block");
            return EXIT_FAILURE;
        }
        ctp = next;
        dispatch_handler(ctp);
    }
}
