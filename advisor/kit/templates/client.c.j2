/*
 * {{ svc }}ctl.c - tiny client for /dev/{{ svc }} (open + devctl).
 * Generated by QNX Integration Advisor for {{ repo_name }}. Apache-2.0.
 *   {{ svc }}ctl            -> prints status as JSON
 *   {{ svc }}ctl set 1500   -> DCMD_{{ SVC }}_SET_VALUE
 */
#include <errno.h>
#include <fcntl.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>

#include <devctl.h>

#include "{{ svc }}_dcmd.h"

int main(int argc, char **argv)
{
    int fd = open("/dev/{{ svc }}", O_RDWR);
    if (fd == -1) {
        perror("open /dev/{{ svc }}");
        return EXIT_FAILURE;
    }
    int rc;
    if (argc == 3 && strcmp(argv[1], "set") == 0) {
        int32_t v = (int32_t)strtol(argv[2], NULL, 10);
        rc = devctl(fd, DCMD_{{ SVC }}_SET_VALUE, &v, sizeof v, NULL);
        if (rc != EOK) {
            fprintf(stderr, "devctl SET_VALUE: %s\n", strerror(rc));
            close(fd);
            return EXIT_FAILURE;
        }
    }
    {{ svc }}_status_t st;
    memset(&st, 0, sizeof st);
    rc = devctl(fd, DCMD_{{ SVC }}_GET_STATUS, &st, sizeof st, NULL);
    close(fd);
    if (rc != EOK) {
        fprintf(stderr, "devctl GET_STATUS: %s\n", strerror(rc));
        return EXIT_FAILURE;
    }
    printf("{\"value\": %d, \"flags\": %u, \"ticks\": %llu}\n",
           (int)st.value, (unsigned)st.flags, (unsigned long long)st.ticks);
    return EXIT_SUCCESS;
}
